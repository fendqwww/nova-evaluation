// Prisma 7: the connection URL no longer lives here — it's supplied via a
// driver adapter (see prisma.config.ts for the CLI, src/server/db.ts for the
// app). Migrating SQLite -> PostgreSQL means swapping the adapter package
// (@prisma/adapter-better-sqlite3 -> @prisma/adapter-pg) and this `provider`
// literal. That stays a small, contained change only if the schema never
// uses `enum` or scalar list fields, since the SQLite connector supports
// neither.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                    String    @id @default(cuid())
  telegramId            String    @unique
  firstName             String
  lastName              String?
  username              String?
  languageCode          String?
  photoUrl              String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  profile            Profile?
  settings           UserSettings?
  goals              Goal[]
  habits             Habit[]
  tasks              Task[]
  workouts           Workout[]
  coachMessages      CoachMessage[]
  coachMemories      CoachMemory[]
  coachBriefs        CoachDailyBrief[]
  nutritionFoods     NutritionFood[]
  nutritionEntries   NutritionEntry[]
  nutritionMeals     NutritionMealTemplate[]
  nutritionWaterLogs NutritionWaterLog[]
  nutritionGoal      NutritionGoal?
  appearanceRoutines AppearanceRoutine[]
  appearancePhotos   AppearancePhoto[]
  appearanceGoals    AppearanceGoal[]
  sleepLogs          SleepLog[]
}

// gender/primaryGoal/occupation are validated against a zod union in
// src/features/onboarding/schemas.ts, not a Prisma `enum` — SQLite's
// connector doesn't support enums, and this keeps the Postgres migration a
// one-line provider change.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  age         Int
  heightCm    Int
  weightKg    Int
  gender      String
  primaryGoal String
  occupation  String
  timezone    String
  // "ocean" | "purple" | "emerald" | "orange" | "rose" | "graphite" — see
  // THEME_VALUES in src/features/onboarding/schemas.ts. String, not an
  // enum, for the same SQLite-compatibility reason as the fields above.
  themeColor  String @default("ocean")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Everything the user has decided about how the app behaves, in one mutable
// row per user — the same shape as NutritionGoal, and for the same reason: a
// setting is the current state of a preference, not a history of preferences,
// so there is nothing here for a past day to point back at.
//
// The row is created lazily. Absence means "nothing has been changed yet", and
// every reader resolves that to DEFAULT_SETTINGS (settings.repository.ts)
// rather than to nulls, so a user who never opens this screen behaves exactly
// like one who opened it and touched nothing.
//
// Two things are deliberately NOT here:
//
//   - timezone. It lives on Profile, which is what every repository in the app
//     already resolves "which day is it for this user" from (see
//     requireUserContext). A second copy here would be a second source of truth
//     for the one question habit streaks depend on, and the two would disagree
//     the first time only one of them was written.
//   - themeColor. The accent palette is also a Profile column and is already
//     wired end to end. themeMode below is a different axis — light/dark/system
//     against which of six hues — so the two coexist rather than compete.
//
// Every categorical column is a plain String validated by a zod union in
// src/features/settings/schemas.ts, not a Prisma enum, for the same SQLite
// connector reason as every other categorical column in this file. Unknown
// values degrade to the default on read instead of throwing.
model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "light" | "dark" | "system". "system" is the default because the honest
  // answer on first launch is "whatever the device prefers", not a guess.
  themeMode String @default("system")
  // "ru" | "en". Only "ru" is translated today; the column exists so the
  // choice is already stored when the second locale lands.
  language  String @default("ru")
  // "dmy" | "mdy" | "iso" — display only. Storage is always CalendarDay.
  dateFormat String @default("dmy")
  // "metric" | "imperial" — display only, for the same reason: kilograms and
  // centimetres are what the columns hold, conversion happens at the edge.
  unitSystem String @default("metric")

  // Per-section notification switches. Storage only for now: nothing sends a
  // notification yet, and a switch that stores an intention is honest where a
  // switch that claims to schedule one would not be.
  notifyHabits     Boolean @default(true)
  notifyTasks      Boolean @default(true)
  notifyNutrition  Boolean @default(false)
  notifyWorkouts   Boolean @default(true)
  notifyAppearance Boolean @default(false)
  notifyCoach      Boolean @default(true)

  // All three AI switches are load-bearing: aiCoachEnabled makes the Coach
  // refuse to answer at all (see get-coach-overview.action.ts), aiDailyReport
  // gates the model-written daily briefing (see generate-daily-brief.action.ts)
  // and aiVisionEnabled gates the two photo-analysis actions (food and
  // appearance). Vision defaults on because it ships enabled: it is only ever
  // reached by deliberately attaching a photo, so an off-by-default switch
  // would read as the feature being broken rather than as a choice.
  aiCoachEnabled  Boolean @default(true)
  aiDailyReport   Boolean @default(true)
  aiVisionEnabled Boolean @default(true)

  // "free" | "plus" | "max". Written by activatePlan (see
  // server/subscription.repository.ts) — today only from the manual admin
  // endpoint, later from a payment provider's webhook, which is the whole
  // reason the grant is one function rather than an UPDATE at the call site.
  //
  // planUntil is when the paid tier lapses; null means "no end date", which is
  // what FREE always has and what a comped account may have. Expiry is applied
  // on *read* (resolvePlan in lib/plan-status.ts), not by a scheduled job, so
  // a lapsed subscription degrades to FREE the moment it is next looked at
  // with nothing to run at midnight. planSince is kept for support ("since
  // when has this account been PLUS?") and for future analytics.
  plan      String    @default("free")
  planSince DateTime?
  planUntil DateTime?

  // One counter across every AI call that actually produced a result — Coach,
  // food-photo analysis, appearance-photo analysis alike (see src/ai/limits.ts,
  // the single place that reads and increments it). A single column rather than
  // one per feature because the product's limit is one shared budget, not three
  // separate ones that would have to be explained separately on the pricing
  // screen.
  //
  // aiUsageCount is the lifetime total, kept for analytics and never compared
  // against a ceiling. What the FREE plan is actually limited by is
  // aiUsageToday, which counts only the calls made on aiUsageDay — the user's
  // own local calendar day. A lifetime ceiling was the previous design and it
  // made "лимит исчерпан" a permanent state an account could never leave,
  // which is exactly what it looked like to a user who had just finished
  // onboarding.
  aiUsageCount Int       @default(0)
  aiUsageToday Int       @default(0)
  // UTC midnight of the local day aiUsageToday belongs to, same convention as
  // HabitLog.date. Null until the account's first AI call.
  aiUsageDay   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Grown exactly the way the original note here anticipated: new nullable
// columns bolted on, never a reshape. Habit and Task have since grown the same
// way, each when it got its own section.
//
// targetDate is stored at UTC midnight and always formatted with
// timeZone: "UTC" (see formatTargetDate in src/features/goals/lib/format.ts).
// A goal's deadline is a calendar day, not an instant, so letting the local
// zone shift it would show the user a different day than the one they picked.
model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  // When, not whether — the same pair Task carries, and for the same reason:
  // "какие цели ты закрыл вчера" is a question isCompleted alone cannot answer,
  // and the AI Coach's daily report is built entirely out of questions like it.
  // Null on a goal completed before this column existed; readers treat that as
  // "closed at some point before the window" rather than as still open.
  completedAt DateTime?
  targetDate  DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  steps GoalStep[]
}

// A goal's checklist. Progress is derived from these rows rather than stored
// on Goal: a cached percentage is a second source of truth that drifts the
// first time a step is added or deleted.
//
// Deliberately no explicit order column — steps read in createdAt order, the
// same convention Goal itself uses. Reordering would need one; nothing else
// would.
model GoalStep {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A habit is a schedule plus a history of days it was kept. Nothing about its
// progress is stored: streaks, adherence and "done this week" are all derived
// from HabitLog rows at the point of display, for the same reason Goal has no
// `progress` column — a cached number is a second source of truth that drifts
// the moment a day is un-ticked.
//
// frequency/weekdayMask/timesPerWeek together form what the client sees as a
// discriminated HabitSchedule union (src/features/habits/types.ts). They are
// three flat columns rather than one JSON blob because SQLite has neither
// enums nor scalar lists, and because a flat Int is queryable if scheduling
// ever needs to move server-side.
model Habit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  note  String?

  // "daily" | "weekdays" | "weekly" — validated by a zod discriminated union
  // in src/features/habits/schemas.ts, not a Prisma enum (SQLite connector).
  frequency    String @default("daily")
  // "weekdays" only: bitmask, bit 0 = Monday … bit 6 = Sunday. 127 = every day.
  weekdayMask  Int    @default(127)
  // "weekly" only: how many days in a week count as keeping the habit.
  timesPerWeek Int    @default(3)

  // Archiving, not deleting, is the honest way to stop a habit: the history
  // stays intact and the streak it earned is still true.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  logs HabitLog[]
}

// One row per day the habit was kept. Absence is the "not done" state, so
// un-ticking a day deletes the row rather than storing a false — a table of
// mostly-false rows would be the same information at several times the size.
//
// `date` is UTC midnight of the user's *local* calendar day, resolved from
// Profile.timezone server-side (see requireUserContext). Same convention as
// Goal.targetDate: a day is a day, not an instant.
//
// The compound unique is what makes ticking idempotent — a double-tap or a
// retried request can only ever produce the one row.
model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  date      DateTime
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

// Grown the same way Goal was: nullable columns added around the original
// title/isCompleted pair, never a reshape.
//
// Deliberately no TaskStep. A checklist under a title is exactly what GoalStep
// already models, and in this product a task that needs sub-items is a goal —
// duplicating the table would give two subtly different checklists to maintain
// and two places for progress semantics to diverge.
model Task {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  note  String?

  isCompleted Boolean   @default(false)
  // When, not whether — Life Score scores tasks finished in the last 7 days,
  // which isCompleted alone cannot answer.
  completedAt DateTime?

  // UTC midnight, formatted with timeZone: "UTC". A due date is a calendar day.
  dueDate  DateTime?
  // "low" | "normal" | "high" — zod union, not an enum (SQLite).
  priority String    @default("normal")

  createdAt DateTime @default(now())
}

// A workout is a *template*: what you intend to do, and on which days. It is
// never a record of a session — that is WorkoutSession, and the separation is
// the whole reason this section can answer both "какой у меня план" and
// "сколько я жал в марте" without either answer being a guess.
//
// weekdayMask is the plan, and it is the same bit convention Habit uses (bit 0
// = Monday … bit 6 = Sunday) so the two sections agree about what "Пн, Ср, Пт"
// means. 0 is a legal value here where it would not be on a Habit: training
// without a fixed schedule is a normal way to train, and the difference between
// "нет плана" and "план на нули" is exactly the difference between a workout
// that owes nothing on any given day and one that is broken.
//
// category is a plain String validated by a zod union in
// src/features/workouts/schemas.ts, not a Prisma enum — SQLite's connector has
// none, the same reason Task.priority and Habit.frequency are strings.
model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  note     String?
  // "strength" | "cardio" | "hiit" | "mobility" | "sport" | "other"
  category String  @default("strength")

  // The plan. 0 = no fixed days.
  weekdayMask Int @default(0)

  // Archiving, not deleting, for the same reason Habit archives: a programme
  // you have finished still happened, and its sessions are still true.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  exercises WorkoutExercise[]
  sessions  WorkoutSession[]
}

// One planned exercise inside a workout: the target, never the result.
//
// Unlike GoalStep this carries an explicit `position`, because the order of
// exercises is part of the plan itself — squats before leg press is a training
// decision, not a display preference.
//
// archivedAt is what makes history survive editing. A logged WorkoutSet points
// at the exercise it was performed on, so deleting an exercise the user has
// already trained would take months of load history with it. Removing an
// exercise from the plan therefore archives it when it has sets behind it and
// only hard-deletes it when it has none — a typo leaves no ghost, a real
// exercise leaves its record.
model WorkoutExercise {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  name           String
  // The target. What actually happened lives in WorkoutSet.
  targetSets     Int     @default(3)
  targetReps     Int     @default(10)
  // Null means bodyweight / not prescribed — 0 would claim a barbell with
  // nothing on it, which is a different statement.
  targetWeightKg Float?
  restSeconds    Int     @default(90)
  note           String?

  position Int @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  sets WorkoutSet[]
}

// One performance of a workout on one calendar day.
//
// `day` is UTC midnight of the user's *local* day, resolved from
// Profile.timezone server-side — the same convention HabitLog.date and
// Goal.targetDate use. A training day is a day, not an instant.
//
// completedAt is when, not whether: the Life Score scores sessions finished in
// the last 7 days, and "какие тренировки ты закрыл вчера" is a question a
// boolean cannot answer. Null means the session is open — started and still
// being logged, which is exactly the state the runner needs to survive the app
// being closed mid-set.
//
// The compound unique makes starting idempotent: a double-tap or a retried
// request can only ever produce the one session for that day.
//
// Nothing derived is stored here. Volume, tonnage, completion percentage and
// duration are all computed from the sets below, for the same reason Goal has
// no `progress` column.
model WorkoutSession {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  day         DateTime
  completedAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  sets WorkoutSet[]

  @@unique([workoutId, day])
  @@index([day])
}

// One set actually performed. Absence is the "not done" state, so un-logging a
// set deletes the row rather than storing a flag — the same choice HabitLog
// makes, and for the same reason: a table of mostly-empty rows would be the
// same information at several times the size.
//
// weightKg is 0 for bodyweight work, which is a real answer rather than a
// missing one: volume for a set of pull-ups is genuinely zero kilograms moved
// by the bar, and the rep count is what carries the effort.
//
// The compound unique is what makes logging idempotent — tapping a set twice
// settles on one row instead of failing on the second attempt.
model WorkoutSet {
  id         String          @id @default(cuid())
  sessionId  String
  session    WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  /// 0-based index of this set within its exercise, for this session.
  position Int
  reps     Int
  weightKg Float @default(0)

  createdAt DateTime @default(now())

  @@unique([sessionId, exerciseId, position])
}

// The AI Coach conversation — one row per turn, never overwritten.
//
// Nothing about the coach's *analysis* is stored: every number it quotes is
// derived from Goal/Habit/Task/Profile at the moment it answers, and the daily
// report reconstructs a past day from the same tables (HabitLog.date,
// Task.completedAt, createdAt). A stored metrics snapshot would be a second
// source of truth that goes stale the moment a day is un-ticked — the same
// reason Goal has no `progress` column. What *is* stored is the conversation,
// because a past answer is a record of what was said, not a derivable fact.
//
// `content` is always plain text and always renderable on its own. `payload`
// carries the structured card (bullets, actions) as JSON — a String, not a Json
// column, because the SQLite connector has no Json type and the shape is
// validated by zod on read anyway (see coachAnswerSchema). A payload that fails
// to parse degrades to `content`, so a schema change can never make old history
// unreadable.
model CoachMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "user" | "coach" — a zod union in src/features/coach/schemas.ts, not a
  // Prisma enum, for the same SQLite-compatibility reason as everything else.
  role    String
  content String
  payload String?

  // UTC midnight of the user's local calendar day, same convention as
  // HabitLog.date — history is grouped into days, and a day is a day.
  day       DateTime
  createdAt DateTime @default(now())

  // History reads newest-first, scoped to one user, and that is the only
  // access pattern there is.
  @@index([userId, createdAt])
}

// What the Coach remembers about a user between conversations.
//
// CoachMessage stores what was *said*; this stores what was *learned* — "не
// любит бег", "тренируется по утрам", "цель — минус 6 кг к декабрю". The
// distinction matters because the transcript is far too long to travel with
// every prompt and far too noisy to reason over: twenty short facts are what
// let the Coach still know a preference a month later, when the turn that
// mentioned it has long since scrolled out of the context window.
//
// Every row is written by the model itself as a side channel on an ordinary
// answer (see src/ai/coach.ts) and is always the user's own statement about
// themselves — never an inference about their health.
model CoachMemory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "preference" | "dislike" | "goal" | "constraint" | "context" — a zod union
  // in src/features/coach/schemas.ts, not a Prisma enum, for the same
  // SQLite-compatibility reason as everything else.
  kind String
  // A stable kebab-case slug the model reuses when it learns more about the
  // same thing, so "не любит бег" is updated rather than duplicated. The
  // unique constraint is what enforces that.
  key  String
  // One sentence, in the user's own terms.
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, updatedAt])
}

// The one AI-written daily briefing, cached for the day it describes.
//
// The Coach screen opens with a proactive message rather than an empty chat,
// and that message costs a Gemini call — so it is generated once per local day
// and read from here on every later open. Caching by day is also what keeps
// the screen cheap to reopen: without it, every visit would spend budget to
// regenerate a text the user has already read.
model CoachDailyBrief {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UTC midnight of the local day, same convention as CoachMessage.day.
  day     DateTime
  // A CoachAnswer as JSON — the same payload shape CoachMessage.payload holds,
  // validated by the same zod schema on the way out.
  payload String

  createdAt DateTime @default(now())

  @@unique([userId, day])
}

// A food in the user's own catalogue: something they created, or a favourite
// they starred. There is no shared/global catalogue — see the note on
// WorkoutsView about the exercise library for the same reasoning: a database
// of foods with correct macros in Russian is a maintenance burden this app
// does not take on, and a user's own kitchen is a short list, not one that
// needs a search index over a universal one.
//
// Macros are stored per 100 g / 100 ml, the units on every packaging label, so
// a logged entry's grams multiply directly into a real amount rather than
// needing a serving-size lookup first.
//
// isFavorite is a plain flag rather than a separate join table: a favourite is
// a property of the food itself here, not a many-to-many relationship to model,
// since every food already belongs to exactly one user.
model NutritionFood {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  // Per 100 g solids / 100 ml liquids — see the note above.
  caloriesPer100 Float
  proteinPer100  Float  @default(0)
  fatPer100      Float  @default(0)
  carbsPer100    Float  @default(0)

  isFavorite Boolean @default(false)

  // Archiving, not deleting, for the same reason Workout archives: an entry
  // already logged against this food still names it correctly on the day it
  // happened, even after the food itself is retired from the picker.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  entries NutritionEntry[]

  @@index([userId, isFavorite])
}

// One thing eaten: a food, an amount, a meal, a day. This is the atomic fact
// the whole section is built on — calories, macros, meal totals and the week's
// statistics are all sums over these rows, never a stored aggregate, for the
// same reason Goal has no `progress` column.
//
// `food` is a required relation rather than a copy of its macros at the time of
// logging: NutritionFood carries the one true set of macros for that name, and
// duplicating them onto every entry would let a corrected typo in a food's
// calorie count silently leave every past day wrong while the food itself now
// reads right. Deleting a food a user has already logged is therefore blocked
// at the repository layer the same way an in-use WorkoutExercise is — archive
// it instead — so a diary day can never lose the food it names.
//
// `mealSlot` is a plain String validated by a zod union in
// src/features/nutrition/schemas.ts, not a Prisma enum — the same
// SQLite-compatibility reason as every other categorical column in this file.
//
// `day` is UTC midnight of the user's local calendar day, resolved from
// Profile.timezone server-side — the same convention HabitLog.date and
// WorkoutSession.day use. A meal belongs to a day, not an instant.
model NutritionEntry {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId String
  food   NutritionFood @relation(fields: [foodId], references: [id], onDelete: Restrict)

  // "breakfast" | "lunch" | "dinner" | "snack"
  mealSlot String

  day     DateTime
  // What was actually eaten, in grams (or millilitres for a drink logged the
  // same way) — multiplied against the food's per-100 macros at read time.
  amountG Float

  createdAt DateTime @default(now())

  @@index([userId, day])
}

// A running total of water for one day. Modelled as one upsertable row per
// day rather than one row per glass — HabitLog and WorkoutSet are absence-is-
// false because a set either happened or it did not, but water is a quantity
// added to gradually through the day, and a "grew by 250 ml" event carries no
// information once summed that the running total does not already have.
//
// `day` is UTC midnight of the user's local calendar day, the same convention
// every other day-scoped table in this file uses.
model NutritionWaterLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  day      DateTime
  amountMl Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
}

// A reusable set of foods and amounts a user logs together often — "мой
// завтрак", "протеиновый перекус" — so filling in a recurring meal is one tap
// against the template rather than re-adding each food. Applying a template
// writes ordinary NutritionEntry rows; nothing about a day's diary points back
// at the template that seeded it, so editing or deleting a template later
// never rewrites history.
model NutritionMealTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  // Suggested slot to pre-select when applying the template — a default, not
  // a constraint, since the same template can be logged at any time of day.
  mealSlot String

  createdAt DateTime @default(now())

  items NutritionMealTemplateItem[]
}

// One food-and-amount line inside a template. Kept as its own table rather
// than a JSON column for the same reason WorkoutExercise is its own table: the
// SQLite connector has no JSON type worth querying, and a template line is a
// small, well-typed row.
//
// foodId has no relation to NutritionFood and is validated for ownership at
// the repository layer instead: a template line survives its food being
// archived (the picker just skips it), and onDelete: Restrict on the relation
// would otherwise block deleting a food the moment any template mentioned it,
// which is a stronger promise than a quick-add list needs to make.
model NutritionMealTemplateItem {
  id         String                @id @default(cuid())
  templateId String
  template   NutritionMealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  foodId  String
  amountG Float

  position Int @default(0)
}

// The user's daily target. One row per user, mutable in place, the same shape
// as Profile: a goal is a current setting to score today's intake against, not
// a history of settings, so there is nothing here for a past day's diary to
// point back at and nothing for the Life Score to misread once it changes.
//
// Zero means "not set" for each macro independently rather than the row being
// wholly absent, because a user who only cares about a calorie ceiling should
// not have to invent protein/fat/carb targets they have no opinion on.
model NutritionGoal {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  calories Int @default(0)
  proteinG Int @default(0)
  fatG     Int @default(0)
  carbsG   Int @default(0)
  waterMl  Int @default(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One care procedure: skincare in the evening, flossing, a beard trim, whatever
// the user invents. Structurally a Habit with an area and an optional checklist
// — and it reuses Habit's exact three scheduling columns (frequency /
// weekdayMask / timesPerWeek, bit 0 = Monday) so "по будням" means the same
// thing in both sections rather than two subtly different calendars.
//
// It is a separate table rather than a flag on Habit because the two answer
// different questions and are scored separately in the Life Score: a habit is
// any repeated intention, a routine is care of a specific part of the body, and
// the area is what makes "чем ухаживать за кожей" answerable at all.
//
// category / timeOfDay / frequency are plain Strings validated by zod unions in
// src/features/appearance/schemas.ts, not Prisma enums — the same SQLite
// connector limitation every other categorical column in this file works
// around.
model AppearanceRoutine {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  note  String?
  // "skin" | "hair" | "teeth" | "body" | "beard" | "nails" | "custom".
  // "beard" is only offered when Profile.gender is "male", but the column
  // accepts it regardless: a routine created before a gender change must keep
  // rendering rather than becoming an unreadable row.
  category String @default("skin")
  // "morning" | "evening" | "any" — skincare genuinely splits into two
  // different routines a day, and grouping the day's list by it is the whole
  // reason it is stored rather than left to the title.
  timeOfDay String @default("any")

  // Identical semantics to Habit's three columns — see the note there.
  frequency    String @default("daily")
  weekdayMask  Int    @default(127)
  timesPerWeek Int    @default(3)

  // Archiving, not deleting, for the same reason Habit archives: a routine you
  // have stopped still happened, and the streak it earned is still true.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  steps AppearanceStep[]
  logs  AppearanceRoutineLog[]
}

// One line of a routine's checklist — "очищение", "тоник", "сыворотка".
//
// createdAt is load-bearing rather than bookkeeping: a routine's completion is
// derived from its steps (see AppearanceStepLog), so a step added today must
// not retroactively make every past day look unfinished. Readers clip each step
// to its own creation day, the same rule habit adherence applies.
//
// position is explicit because the order of a skincare routine is part of the
// instruction — toner before serum is a decision, not a display preference.
model AppearanceStep {
  id        String            @id @default(cuid())
  routineId String
  routine   AppearanceRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  title    String
  position Int    @default(0)

  createdAt DateTime @default(now())

  logs AppearanceStepLog[]
}

// A routine *without* a checklist, performed on one day.
//
// Only ever written for a stepless routine. When a routine has steps, its step
// logs are the record and this table stays empty for it — storing both would be
// two sources of truth for the same fact, and the derived one would drift the
// moment a step was ticked. See doneOn() in features/appearance/lib/stats.ts,
// which is the single place that rule lives.
//
// `day` is UTC midnight of the user's local calendar day, resolved from
// Profile.timezone server-side — the same convention HabitLog.date uses.
// Absence is the "not done" state, so un-ticking deletes the row.
model AppearanceRoutineLog {
  id        String            @id @default(cuid())
  routineId String
  routine   AppearanceRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  day       DateTime
  createdAt DateTime @default(now())

  @@unique([routineId, day])
}

// One checklist item ticked on one day. The atomic fact a routine with steps is
// judged by: the routine counts as done for a day when every step that existed
// by then carries a row here for it.
//
// The compound unique is what makes ticking idempotent, exactly like HabitLog.
model AppearanceStepLog {
  id     String         @id @default(cuid())
  stepId String
  step   AppearanceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  day       DateTime
  createdAt DateTime @default(now())

  @@unique([stepId, day])
}

// A progress photo.
//
// The bytes live in the row as data: URIs rather than in object storage,
// because this app has none — SQLite and a Telegram Mini App, no S3, no CDN.
// Two sizes are stored rather than one resized on read: SQLite cannot resize an
// image, and shipping a full-resolution photo to render a 100px grid cell would
// make the gallery unusable on mobile data.
//
// `thumbData` is what the section's snapshot carries; `imageData` is fetched one
// photo at a time when the viewer or the До/После comparison actually needs it.
// Both are produced client-side by lib/image.ts, which is also where the size
// ceilings enforced in schemas.ts come from.
//
// `day` is the user's local calendar day, the same convention as everything
// else here — a progress photo belongs to a day, not to an instant.
model AppearancePhoto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which area this documents — the same union AppearanceRoutine.category uses,
  // so "фото кожи" and "уход за кожей" line up in the comparison view.
  category String @default("skin")
  day      DateTime
  note     String?

  /// data: URI, ~256px longest side. Ships with the section snapshot.
  thumbData String
  /// data: URI, ~1024px longest side. Fetched on demand, never in bulk.
  imageData String
  /// Pixel dimensions of the full image, so a viewer can reserve space for it.
  width     Int
  height    Int

  /// The AI reading of this photo, as JSON matching appearanceAnalysisSchema
  /// (src/ai/types.ts). A String, not a Json column, for the same reason
  /// CoachMessage.cardJson is: the SQLite connector has no Json type.
  ///
  /// Stored rather than recomputed because an analysis costs a call from the
  /// user's daily AI budget — without this, closing the viewer threw the
  /// result away and reopening the photo charged for it again.
  analysisJson String?
  /// When that analysis was produced, so the viewer can offer a refresh on a
  /// stale reading without having to parse the JSON to find out.
  analyzedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, day])
}

// A goal about how the user wants to look — "отрастить бороду", "убрать
// сухость кожи". Deliberately not a Goal row with a tag: Goal is counted by the
// Life Score as general life direction, and silently inflating that count from
// this section would make the two numbers disagree about what a goal is.
//
// No steps table of its own: the routines *are* the steps, which is the whole
// point of a section where the work is repeated care rather than a checklist
// you finish once.
//
// completedAt is when, not whether — the same pair Goal and Task carry, for the
// same reason: "что я закрыл на этой неделе" is not a question a boolean can
// answer.
model AppearanceGoal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  note     String?
  // Same area union as AppearanceRoutine.category.
  category String @default("skin")

  // UTC midnight, formatted with timeZone: "UTC". A deadline is a calendar day.
  targetDate DateTime?

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
}

// One night's sleep, logged the morning after. One row per day, the same
// upsertable shape as NutritionWaterLog rather than an absence-is-false log
// like HabitLog — sleep is a quantity with a quality attached, not a thing
// that either happened or did not.
//
// bedTime/wakeTime are "HH:mm" strings rather than DateTimes: a bedtime is a
// wall-clock moment the user glanced at, not an instant that needs a
// timezone, and storing it as a plain string keeps it printable without ever
// re-deriving a zone for it. durationMin is computed server-side from the
// pair at write time (see minutesBetween in features/sleep/lib/duration.ts)
// rather than trusted from the client, so a forged payload cannot claim an
// impossible night.
//
// `day` is UTC midnight of the user's local calendar day, the same
// convention every other day-scoped table in this file uses — the day being
// logged is the morning woken up on, so a bedtime just after midnight still
// files under the day that follows it.
model SleepLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  day         DateTime
  bedTime     String
  wakeTime    String
  durationMin Int
  // 1 (плохо) – 5 (отлично).
  quality     Int      @default(3)
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, day])
}
